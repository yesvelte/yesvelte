{
	"name": "yesvelte",
	"version": "0.0.2-next.219",
	"description": "YeSvelte UI component library for Svelte",
	"keywords": [
		"svelte",
		"sveltejs",
		"bootstrap",
		"tabler",
		"svelte tabler",
		"svelte bootstrap",
		"svelte components",
		"svelte ui components",
		"svelte-kit",
		"sveltekit",
		"yesvelte",
		"tabler"
	],
	"homepage": "https://www.yesvelte.com",
	"bugs": {
		"url": "https://github.com/yesvelte/yesvelte/issues",
		"email": "ap@momentaj.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yesvelte/yesvelte.git"
	},
	"license": "MIT License",
	"author": "Amir Pournasserian <ap@momentaj.com>",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run style && svelte-kit sync && svelte-package",
		"build:site": "npm run style && vite build",
		"publish": "npm run build && npm publish ./package/",
		"prepublishOnly": "echo 'Did you mean to publish `./package/`, instead of `./`?' && exit 1",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"tailwind": "tailwindcss -c src/scss/daisyui/tailwind/tailwind.config.cjs -i src/scss/daisyui/tailwind/tailwind.css -o src/styles/tailwind.css",
		"style": "node scripts/styles.generator.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.0.0",
		"vite": "^6.2.5"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.6.13",
		"@tabler/core": "^1.0.0-beta19",
		"cssnano": "^7.0.6",
		"daisyui": "^3.9.4",
		"estree-walker": "^3.0.3",
		"focus-trap": "^7.6.4",
		"fuzzy": "^0.1.3",
		"iconify-icon": "^2.3.0",
		"inputmask": "^5.0.9",
		"litepicker": "^2.0.12",
		"magic-string": "^0.30.17",
		"moment": "^2.30.1",
		"nouislider": "^15.8.1",
		"param-case": "^3.0.4",
		"postcss": "^8.5.3",
		"postcss-rtlcss": "^5.7.0",
		"postcss-selector-replace": "^1.0.2",
		"prismjs": "^1.30.0",
		"quill": "^2.0.3",
		"sass": "^1.62.0",
		"sass-embedded": "^1.86.3",
		"tom-select": "^2.4.3"
	}
}
